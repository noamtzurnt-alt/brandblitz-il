##############################################
# BrandBlitz – Environment Variables (Example)
# Copy to `.env.local` for local development.
# NEVER commit real secrets to GitHub.
##############################################

## App
APP_URL="https://brandblitz.store"

## Firebase (Client / Public)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"

## Firebase (Admin / Server)
FIREBASE_ADMIN_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"

## Cloudflare R2
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_BUCKET_NAME"
R2_PUBLIC_URL="https://YOUR_PUBLIC_R2_BASE_URL"

## Google Vertex AI / Gemini / Imagen / Veo
VERTEX_PROJECT_ID="YOUR_VERTEX_PROJECT_ID"
VERTEX_LOCATION="europe-west1"
VERTEX_CLIENT_EMAIL="vertex-service-account@YOUR_VERTEX_PROJECT.iam.gserviceaccount.com"
VERTEX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional for local dev if using ADC / credentials JSON on disk
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

## Veo (Premium video)
VEO_LOCATION="europe-west1"
VEO_MODEL_ID="veo-3.1-generate-preview"

## Remotion worker
REMOTION_AUDIO_BASE_URL="http://localhost:3000"

## Jamendo (music)
JAMENDO_CLIENT_ID="YOUR_JAMENDO_CLIENT_ID"

## Meta (Facebook/Instagram)
META_GRAPH_API_VERSION="v25.0"
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_CLIENT_TOKEN="YOUR_META_CLIENT_TOKEN"
META_REDIRECT_URL="https://brandblitz.store/api/integrations/meta/callback"
META_STATE_SECRET="YOUR_META_STATE_SECRET"

## Auto upload cron auth
CRON_SECRET="YOUR_CRON_SECRET"

## Make callback (legacy / optional if still used)
MAKE_CALLBACK_SECRET="YOUR_MAKE_CALLBACK_SECRET"

## Admin / testing flags
ALLOW_TEST_CREDITS="false"

## Cloudinary (legacy / optional)
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET="YOUR_CLOUDINARY_UPLOAD_PRESET"

